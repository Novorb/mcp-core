{
  "name": "@novorb/mcp-core",
  "version": "3.0.0",
  "description": "Shared utilities for MCP servers: logger, HTTP client, retry, pagination, transport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/logger.js",
    "./retry": "./dist/retry.js",
    "./pagination": "./dist/pagination.js",
    "./http-client": "./dist/http-client.js",
    "./transport": "./dist/transport.js",
    "./server": "./dist/server.js"
  },
  "typesVersions": {
    "*": {
      "logger": [
        "dist/logger.d.ts"
      ],
      "retry": [
        "dist/retry.d.ts"
      ],
      "pagination": [
        "dist/pagination.d.ts"
      ],
      "http-client": [
        "dist/http-client.d.ts"
      ],
      "transport": [
        "dist/transport.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-jest.mjs --runInBand",
    "test:watch": "node scripts/run-jest.mjs --watch",
    "test:coverage": "node scripts/run-jest.mjs --runInBand --coverage",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "secretlint": "secretlint \"**/*\" --secretlintignore .gitignore",
    "docs:check": "node scripts/check-docs-freshness.mjs",
    "qa:all": "node scripts/qa-all.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "utilities",
    "logger",
    "http-client",
    "retry",
    "pagination"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novorb/mcp-core.git"
  },
  "homepage": "https://github.com/Novorb/mcp-core#readme",
  "bugs": {
    "url": "https://github.com/Novorb/mcp-core/issues"
  },
  "author": "novorb",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@jest/globals": "^30.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "jest": "^30.3.0",
    "secretlint": "^13.0.5",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  },
  "pnpm": {
    "//overrides": "Scoped security patches for transitive deps (the @modelcontextprotocol/node hono adapter, ajv's fast-uri, and the jest/babel dev toolchain). All same-major, semver-compatible bumps; verified by the test suite (HTTP transport).",
    "overrides": {
      "hono": "^4.13.11",
      "follow-redirects": "^1.16.1",
      "@hono/node-server": "^1.19.15",
      "fast-uri": "^3.1.6",
      "picomatch": "^4.0.7",
      "js-yaml": "^4.1.0",
      "browserslist": "^4.28.9",
      "@babel/core": "^7.29.7",
      "baseline-browser-mapping": "^2.11.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ]
}
