{
  "name": "@novorb/mcp-core",
  "version": "3.0.0",
  "description": "Shared utilities for MCP servers: the SDK v2 surface, logger, HTTP client, retry, pagination, transport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/utils/logger.js",
    "./retry": "./dist/retry.js",
    "./pagination": "./dist/pagination.js",
    "./http-client": "./dist/http-client.js",
    "./transport": "./dist/transport.js",
    "./server": "./dist/server.js",
    "./tools": "./dist/tools.js",
    "./bootstrap": "./dist/bootstrap.js",
    "./env": "./dist/utils/envLoader.js",
    "./data-store": "./dist/utils/dataStore.js",
    "./auth": "./dist/auth.js",
    "./express": "./dist/express.js",
    "./testing": "./dist/testing/index.js",
    "./sdk/server": "./dist/sdk/server.js",
    "./sdk/server/stdio": "./dist/sdk/server-stdio.js",
    "./sdk/node": "./dist/sdk/node.js",
    "./sdk/client": "./dist/sdk/client.js",
    "./sdk/client/stdio": "./dist/sdk/client-stdio.js",
    "./sdk/express": "./dist/sdk/express.js"
  },
  "typesVersions": {
    "*": {
      "logger": [
        "dist/utils/logger.d.ts"
      ],
      "retry": [
        "dist/retry.d.ts"
      ],
      "pagination": [
        "dist/pagination.d.ts"
      ],
      "http-client": [
        "dist/http-client.d.ts"
      ],
      "transport": [
        "dist/transport.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ],
      "tools": [
        "dist/tools.d.ts"
      ],
      "bootstrap": [
        "dist/bootstrap.d.ts"
      ],
      "env": [
        "dist/utils/envLoader.d.ts"
      ],
      "data-store": [
        "dist/utils/dataStore.d.ts"
      ],
      "auth": [
        "dist/auth.d.ts"
      ],
      "express": [
        "dist/express.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "sdk/server": [
        "dist/sdk/server.d.ts"
      ],
      "sdk/server/stdio": [
        "dist/sdk/server-stdio.d.ts"
      ],
      "sdk/node": [
        "dist/sdk/node.d.ts"
      ],
      "sdk/client": [
        "dist/sdk/client.d.ts"
      ],
      "sdk/client/stdio": [
        "dist/sdk/client-stdio.d.ts"
      ],
      "sdk/express": [
        "dist/sdk/express.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "test": "node scripts/run-jest.mjs --runInBand",
    "test:watch": "node scripts/run-jest.mjs --watch",
    "test:coverage": "node scripts/run-jest.mjs --runInBand --coverage",
    "lint": "biome check src tests scripts examples",
    "format": "biome check --write src tests scripts examples",
    "secretlint": "secretlint \"**/*\" --secretlintignore .gitignore",
    "docs:check": "node scripts/check-docs-freshness.mjs",
    "qa:all": "node scripts/qa-all.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "utilities",
    "logger",
    "http-client",
    "retry",
    "pagination"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novorb/mcp-core.git"
  },
  "homepage": "https://github.com/Novorb/mcp-core#readme",
  "bugs": {
    "url": "https://github.com/Novorb/mcp-core/issues"
  },
  "author": "novorb",
  "peerDependencies": {
    "@modelcontextprotocol/express": "~2.0.2",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/express": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@modelcontextprotocol/node": "~2.1.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@jest/globals": "^30.3.0",
    "@modelcontextprotocol/express": "~2.0.2",
    "@modelcontextprotocol/ext-tasks": "0.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "express": "^5.2.1",
    "jest": "^30.3.0",
    "secretlint": "^13.0.5",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  },
  "pnpm": {
    "//overrides": "Scoped security patches for transitive deps (the @modelcontextprotocol/node hono adapter, ajv's fast-uri, and the jest/babel dev toolchain). All same-major, semver-compatible bumps; verified by the test suite (HTTP transport).",
    "overrides": {
      "hono": "^4.13.11",
      "follow-redirects": "^1.16.1",
      "@hono/node-server": "^1.19.15",
      "fast-uri": "^3.1.6",
      "picomatch": "^4.0.7",
      "js-yaml": "^4.1.0",
      "browserslist": "^4.28.9",
      "@babel/core": "^7.29.7",
      "baseline-browser-mapping": "^2.11.0"
    }
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "dist",
    "examples"
  ]
}
